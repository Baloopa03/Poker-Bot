{
  "manifest_version": 3,
  "name": "Poker Bot (advisor)",
  "version": "0.1.0",
  "description": "Reads your pokerpatio table and suggests plays. Never clicks or acts for you.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Poker Bot: open pokerpatio.com and the panel appears on the table",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://pokerpatio.com/*",
        "https://*.pokerpatio.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pokerpatio.com/*",
        "https://*.pokerpatio.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
